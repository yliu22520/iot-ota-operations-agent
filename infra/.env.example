PUBLIC_DOMAIN=demo.example.com
CADDY_ACME_EMAIL=ops@example.com

POSTGRES_DB=ota_operations
POSTGRES_USER=ota
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

DEMO_OPERATOR_USERNAME=demo-operator
DEMO_OPERATOR_PASSWORD=replace-with-a-strong-demo-operator-password
SESSION_COOKIE_SECURE=true

DIAGNOSTIC_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=replace-with-real-key-on-server-only
DEEPSEEK_BASE_URL=https://api.deepseek.com

DEMO_LIVE_DIAGNOSIS_DAILY_LIMIT=20
DEMO_LIVE_DIAGNOSIS_PER_MINUTE_LIMIT=3
DEMO_DATA_RESET_ENABLED=true
DEMO_DATA_RESET_INTERVAL_MS=86400000
DEMO_DATA_RESET_INITIAL_DELAY_MS=86400000

DOCKER_JAVA_TOOL_OPTIONS=-Xms256m -Xmx1280m -XX:+ExitOnOutOfMemoryError
DOCKER_HTTP_PROXY=
DOCKER_HTTPS_PROXY=
DOCKER_NO_PROXY=localhost,127.0.0.1,postgres,backend,frontend,caddy
DOCKER_MAVEN_PROXY_HOST=
DOCKER_MAVEN_PROXY_PORT=
